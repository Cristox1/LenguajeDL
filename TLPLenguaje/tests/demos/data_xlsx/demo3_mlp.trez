// demo3_mlp.trez ────────────────────────────────────────────────────────────
// Deep Learning entrenable: MLP de tres capas para clasificar sexo.
//
// La regresión logística (demo2) es lineal en las features. El MLP introduce
// no linealidades (ReLU) y debería superarla en accuracy.
//
// Arquitectura: 3 → 8 → 4 → 1  (sigmoide implícito vía threshold 0.5)
// Loss: MSE
// Pipeline:
//   1. Leer xlsx, 800 filas, mismas features que demo2
//   2. Codificar sex y escalar
//   3. Split 80/20
//   4. NNdoz.mlp_init([3,8,4,1])  → 3 capas lineales + ReLU intercaladas
//   5. NNdoz.mlp_train  → forward + backward + SGD durante 1200 épocas
//   6. Umbralizar en 0.5 → predicción binaria
//   7. Accuracy + matriz de confusión + curva de loss en SVG
// ────────────────────────────────────────────────────────────────────────────

Randomdoz.seed(13);

let raw   = Datadoz.read_xlsx("../tests/data.xlsx");
let datos = raw.slice(0, 800);
let n     = len(datos);

let X = [];
let Y = [];
let i = 0;
while (i < n) {
    let fila = Datadoz.fila(datos, i);
    let X = append(X, [
        fila["edad"]            / 50.0,
        fila["ingreso_mensual"] / 10000.0,
        fila["anios_esc"]       / 12.0
    ]);
    if (fila["sex"] == "Hombre") {
        let Y = append(Y, 1.0);
    } else {
        let Y = append(Y, 0.0);
    }
    let i = i + 1;
}

let split = Datadoz.train_test_split(X, Y, 0.2);
let Xtr = split[0]; let Ytr = split[1];
let Xte = split[2]; let Yte = split[3];

mostrar("Train / Test:");
mostrar(len(Xtr));
mostrar(len(Xte));

// Crear MLP 3 → 8 → 4 → 1 y entrenarlo
let capas = NNdoz.mlp_init([3, 8, 4, 1]);
mostrar("Parametros totales:");
mostrar(NNdoz.param_count(capas));

let res  = NNdoz.mlp_train(capas, Xtr, Ytr, 0.05, 1200, "mse");
let hist = res["historia"];
mostrar("Loss inicial / final:");
mostrar(hist[0]);
mostrar(hist[len(hist) - 1]);

// Predecir y umbralizar en 0.5
let preds_raw = NNdoz.mlp_predict(res["layers"], Xte);
let y_pred = [];
let j = 0;
while (j < len(preds_raw)) {
    let s = preds_raw[j][0];
    if (s >= 0.5) {
        let y_pred = append(y_pred, 1);
    } else {
        let y_pred = append(y_pred, 0);
    }
    let j = j + 1;
}

// Convertir Yte a enteros para métricas
let Yte_int = [];
let k = 0;
while (k < len(Yte)) {
    if (Yte[k] >= 0.5) {
        let Yte_int = append(Yte_int, 1);
    } else {
        let Yte_int = append(Yte_int, 0);
    }
    let k = k + 1;
}

let acc = Metricsdoz.accuracy(Yte_int, y_pred);
let f1  = Mldoz.f1(Yte_int, y_pred);
mostrar("Accuracy test (MLP):");
mostrar(acc);
mostrar("F1 (MLP):");
mostrar(f1);

// Gráficas
Plotdoz.learning_curve(hist, [], "MLP sexo", "Epoca", "MSE",
    "../tests/out_demo3_curve.svg");
Plotdoz.confusion_matrix(Yte_int, y_pred, ["Mujer", "Hombre"],
    "MLP — Matriz de confusion",
    "../tests/out_demo3_confmat.svg");

mostrar("OK demo3");
