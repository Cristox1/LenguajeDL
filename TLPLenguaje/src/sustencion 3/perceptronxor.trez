Randomdoz.seed(7);

let X = [[0, 0], [0, 1], [1, 0], [1, 1]];
let Y = [0, 1, 1, 0];

let capas = NNdoz.mlp_init([2, 4, 1]);
let res   = NNdoz.mlp_train(capas, X, Y, 0.1, 10000, "mse");
let hist  = res["historia"];

mostrar("Loss inicial:");
mostrar(hist[0]);
mostrar("Loss final:");
mostrar(hist[len(hist) - 1]);

let preds_raw = NNdoz.mlp_predict(res["layers"], X);
let p00 = 0; let p01 = 0; let p10 = 0; let p11 = 0;
if (preds_raw[0][0] >= 0.5) { let p00 = 1; }
if (preds_raw[1][0] >= 0.5) { let p01 = 1; }
if (preds_raw[2][0] >= 0.5) { let p10 = 1; }
if (preds_raw[3][0] >= 0.5) { let p11 = 1; }

mostrar("Predicciones MLP:");
mostrar("  [0,0] ->");
mostrar(p00);
mostrar("  [0,1] ->");
mostrar(p01);
mostrar("  [1,0] ->");
mostrar(p10);
mostrar("  [1,1] ->");
mostrar(p11);

let preds = [p00, p01, p10, p11];
let acc = Metricsdoz.accuracy(Y, preds);
mostrar("Accuracy MLP multicapa:");
mostrar(acc);

Plotdoz.learning_curve(hist, [], "MLP XOR — Curva de aprendizaje", "Epoca", "MSE",
    "../tests/out_xor_curve.svg");

if (acc == 1.0) {
    mostrar("MLP aprendio XOR correctamente con capas ocultas.");
} else {
    mostrar("No convergio del todo — prueba mas epocas o diferente seed.");
}
