// pele_metrics.pele — Metricas de Evaluacion de Modelos
// Implementada 100% en PELE bajo el Paradigma Funcional

// Precision: TP / (TP + FP)
funcion precision(y_real, y_pred, clase_pos) {
    tp = 0; fp = 0;
    n = longitud(y_real);
    por (i = 0; i < n; i = i + 1) {
        si (arr_get(y_pred, i) == clase_pos) {
            si (arr_get(y_real, i) == clase_pos) { tp = tp + 1; }
            sino { fp = fp + 1; }
        }
    }
    si (tp + fp == 0) { retornar 0.0; }
    retornar tp / (tp + fp);
}

// Recall: TP / (TP + FN)
funcion recall(y_real, y_pred, clase_pos) {
    tp = 0; fn = 0;
    n = longitud(y_real);
    por (i = 0; i < n; i = i + 1) {
        si (arr_get(y_real, i) == clase_pos) {
            si (arr_get(y_pred, i) == clase_pos) { tp = tp + 1; }
            sino { fn = fn + 1; }
        }
    }
    si (tp + fn == 0) { retornar 0.0; }
    retornar tp / (tp + fn);
}

// F1 Score: 2 * (precision * recall) / (precision + recall)
funcion f1_score(y_real, y_pred, clase_pos) {
    p = precision(y_real, y_pred, clase_pos);
    r = recall(y_real, y_pred, clase_pos);
    si (p + r == 0) { retornar 0.0; }
    retornar 2.0 * p * r / (p + r);
}

// R2 Score: 1 - SS_res / SS_tot
funcion r2_score(y_real, y_pred) {
    n = longitud(y_real);
    media = 0;
    por (i = 0; i < n; i = i + 1) { media = media + arr_get(y_real, i); }
    media = media / n;
    ss_res = 0; ss_tot = 0;
    por (i = 0; i < n; i = i + 1) {
        diff_r = arr_get(y_real, i) - arr_get(y_pred, i);
        diff_t = arr_get(y_real, i) - media;
        ss_res = ss_res + diff_r * diff_r;
        ss_tot = ss_tot + diff_t * diff_t;
    }
    si (ss_tot == 0) { retornar 1.0; }
    retornar 1.0 - ss_res / ss_tot;
}

// RMSE: sqrt(MSE)
funcion rmse(y_real, y_pred) {
    retornar pele_sqrt(pele_mse(y_real, y_pred));
}

// MAE: Mean Absolute Error
funcion mae(y_real, y_pred) {
    n = longitud(y_real);
    suma = 0;
    por (i = 0; i < n; i = i + 1) {
        diff = arr_get(y_real, i) - arr_get(y_pred, i);
        si (diff < 0) { diff = -diff; }
        suma = suma + diff;
    }
    retornar suma / n;
}

// Confusion Matrix (para clasificacion binaria: clases 0 y 1)
funcion confusion_matrix(y_real, y_pred) {
    tp = 0; tn = 0; fp = 0; fn = 0;
    n = longitud(y_real);
    por (i = 0; i < n; i = i + 1) {
        real = arr_get(y_real, i);
        pred = arr_get(y_pred, i);
        si (real == 1 && pred == 1) { tp = tp + 1; }
        si (real == 0 && pred == 0) { tn = tn + 1; }
        si (real == 0 && pred == 1) { fp = fp + 1; }
        si (real == 1 && pred == 0) { fn = fn + 1; }
    }
    retornar [[tn, fp], [fn, tp]];
}
