// seno.trez ─────────────────────────────────────────────────────────────────
// Graficar sin(x) usando solo TREZ.
//   · sin / cos / PI  → constantes y funciones nativas de Mathdoz
//                       (PI se expone como constante global)
//   · Plotdoz.line_chart → SVG sin matplotlib
//
// Genera 200 puntos en x ∈ [-2π, 2π] y los dibuja.
// ────────────────────────────────────────────────────────────────────────────

let N    = 200;
let dosPi = 2.0 * PI;
let xmin = 0.0 - dosPi;
let xmax = dosPi;
let paso = (xmax - xmin) / (N - 1);

let xs = [];
let ys = [];
let i  = 0;
while (i < N) {
    let x  = xmin + paso * i;
    let y  = sin(x);
    let xs = append(xs, x);
    let ys = append(ys, y);
    let i  = i + 1;
}

mostrar("Puntos generados:");
mostrar(N);
mostrar("Rango x:");
mostrar(xmin);
mostrar(xmax);
mostrar("sin(0) =");
mostrar(sin(0.0));
mostrar("sin(PI/2) =");
let medioPi = PI / 2.0;
mostrar(sin(medioPi));
mostrar("sin(PI) =");
mostrar(sin(PI));

Plotdoz.line_chart(xs, ys, "y = sin(x)", "x", "sin(x)",
    "../tests/final/out_seno.svg");

mostrar("OK seno");
