// demo_iris_knn.trez
// Clasificación multiclase con KNN sobre el dataset Iris (sklearn).
// Pipeline completo: carga CSV → normalizar → split → entrenar → evaluar → graficar.

Randomdoz.seed(42);

// ── 1. Cargar dataset Iris ────────────────────────────────────────────────────
let datos = Datadoz.read_csv("../tests/iris.csv");
let n = Datadoz.num_filas(datos);
mostrar("Total filas:");
mostrar(n);

let sl  = Datadoz.columna(datos, "sepal_length");
let sw  = Datadoz.columna(datos, "sepal_width");
let pl  = Datadoz.columna(datos, "petal_length");
let pw  = Datadoz.columna(datos, "petal_width");
let lab = Datadoz.columna(datos, "label");

// ── 2. Construir X e Y (Y como enteros) ──────────────────────────────────────
let X = [];
let Y = [];
let i = 0;
while (i < n) {
    let X = append(X, [sl[i], sw[i], pl[i], pw[i]]);
    let Y = append(Y, int(lab[i]));
    let i = i + 1;
}

// ── 3. Split 80 / 20 con Datadoz ─────────────────────────────────────────────
let split   = Datadoz.train_test_split(X, Y, 0.2);
let X_train = split[0];
let Y_train = split[1];
let X_test  = split[2];
let Y_test  = split[3];

mostrar("Filas entrenamiento:");
mostrar(len(X_train));
mostrar("Filas test:");
mostrar(len(X_test));

// ── 4. Normalizar con MinMaxScaler ───────────────────────────────────────────
let scaler  = Sklearndoz.MinMaxScaler();
let X_train_n = Sklearndoz.fit_transform(scaler, X_train);
let X_test_n  = Sklearndoz.transform(scaler, X_test);

// ── 5. Entrenar KNN (k=5) ────────────────────────────────────────────────────
let knn = Sklearndoz.KNeighborsClassifier(5);
Sklearndoz.fit(knn, X_train_n, Y_train);

// ── 6. Predecir y evaluar ────────────────────────────────────────────────────
let y_pred = Sklearndoz.predict(knn, X_test_n);

let acc = Metricsdoz.accuracy(Y_test, y_pred);
mostrar("Accuracy KNN (k=5):");
mostrar(acc);

let conf = Metricsdoz.confusion_matrix(Y_test, y_pred);
mostrar("Matriz de confusion:");
mostrar(conf["matriz"]);

// ── 7. Métricas por clase ────────────────────────────────────────────────────
let prec0 = Metricsdoz.precision(Y_test, y_pred, 0);
let prec1 = Metricsdoz.precision(Y_test, y_pred, 1);
let prec2 = Metricsdoz.precision(Y_test, y_pred, 2);

let f1_0 = Metricsdoz.f1_score(Y_test, y_pred, 0);
let f1_1 = Metricsdoz.f1_score(Y_test, y_pred, 1);
let f1_2 = Metricsdoz.f1_score(Y_test, y_pred, 2);

mostrar("Precision [Setosa, Versicolor, Virginica]:");
mostrar([prec0, prec1, prec2]);
mostrar("F1-score [Setosa, Versicolor, Virginica]:");
mostrar([f1_0, f1_1, f1_2]);

// ── 8. Extraer features 2 y 3 del test para visualizar ───────────────────────
let pl_test = [];
let pw_test = [];
let j = 0;
while (j < len(X_test_n)) {
    let pl_test = append(pl_test, X_test_n[j][2]);
    let pw_test = append(pw_test, X_test_n[j][3]);
    let j = j + 1;
}

let nombres_clase = ["Setosa", "Versicolor", "Virginica"];

// ── 9. Grafica 1: scatter con predicciones del KNN ───────────────────────────
Plotdoz.scatter_classes(pl_test, pw_test, y_pred, nombres_clase,
    "KNN Iris — Predicciones (petal_length vs petal_width)",
    "petal_length (norm)", "petal_width (norm)",
    "../tests/out_iris_scatter_pred.png");

// ── 10. Grafica 2: scatter con etiquetas reales ───────────────────────────────
Plotdoz.scatter_classes(pl_test, pw_test, Y_test, nombres_clase,
    "KNN Iris — Etiquetas reales (petal_length vs petal_width)",
    "petal_length (norm)", "petal_width (norm)",
    "../tests/out_iris_scatter_real.png");

// ── 11. Grafica 3: Matriz de confusion ───────────────────────────────────────
Plotdoz.confusion_matrix(Y_test, y_pred, nombres_clase,
    "KNN Iris — Matriz de confusion",
    "../tests/out_iris_confmat.png");

// ── 12. Grafica 4: Bar chart precision por clase ─────────────────────────────
Plotdoz.bar_chart(nombres_clase, [prec0, prec1, prec2],
    "KNN Iris — Precision por clase",
    "Clase", "Precision",
    "../tests/out_iris_precision.png");

mostrar("=== DEMO IRIS KNN COMPLETO ===");
mostrar("Accuracy final:");
mostrar(acc);
