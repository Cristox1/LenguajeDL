// test_mlp_csv.trez — MLP entrenable sobre dataset CSV real
// 4 features, 2 clases, 60 puntos linealmente separables con ruido.

Randomdoz.seed(42);

let datos = Datadoz.read_csv("../tests/datos_test.csv");
let f1 = Datadoz.columna(datos, "feature_1");
let f2 = Datadoz.columna(datos, "feature_2");
let f3 = Datadoz.columna(datos, "feature_3");
let f4 = Datadoz.columna(datos, "feature_4");
let lab = Datadoz.columna(datos, "label");

// Componer matriz X
let X = [];
let Y = [];
let i = 0;
let n = len(f1);
while (i < n) {
    let X = append(X, [f1[i], f2[i], f3[i], f4[i]]);
    let Y = append(Y, lab[i]);
    let i = i + 1;
}

// Split 80/20
let split   = Datadoz.train_test_split(X, Y, 0.2);
let X_train = split[0]; let Y_train = split[1];
let X_test  = split[2]; let Y_test  = split[3];

// MLP 4 → 8 → 1, MSE, 800 épocas
let capas = NNdoz.mlp_init([4, 8, 1]);
let res   = NNdoz.mlp_train(capas, X_train, Y_train, 0.05, 800, "mse");
let hist  = res["historia"];

// La pérdida debe haber bajado significativamente
let loss0 = hist[0];
let lossN = hist[len(hist) - 1];
let mitad = loss0 * 0.5;
mostrar(lossN < mitad);   // true: bajó al menos a la mitad

// Predecir test y umbralizar en 0.5
let preds = NNdoz.mlp_predict(res["layers"], X_test);
let y_pred = [];
let j = 0;
while (j < len(preds)) {
    let p = preds[j][0];
    if (p >= 0.5) {
        let y_pred = append(y_pred, 1);
    } else {
        let y_pred = append(y_pred, 0);
    }
    let j = j + 1;
}

// Accuracy ≥ 0.85 sobre test
let acc = Metricsdoz.accuracy(Y_test, y_pred);
mostrar(acc >= 0.85);    // true

// Guardar curva de aprendizaje y matriz de confusión
Plotdoz.learning_curve(hist, [], "MLP CSV", "Epoca", "MSE",
    "../tests/out_mlp_csv_curve.svg");
Plotdoz.confusion_matrix(Y_test, y_pred, ["clase 0", "clase 1"],
    "MLP CSV — Matriz de confusión", "../tests/out_mlp_csv_confmat.svg");

mostrar("MLP CSV ok");
