// demo_naive_bayes.trez — Naive Bayes Gaussiano
// Dataset: iris (sklearn) — clasificacion 3 clases
// Algoritmo: Mldoz.nb_fit (distribucion gaussiana por clase)

Randomdoz.seed(21);

let datos = Datadoz.read_csv("../tests/demos/ml_sklearn/datasets/iris.csv");
let n = Datadoz.num_filas(datos);
mostrar("Filas dataset iris:");
mostrar(n);

let sl  = Datadoz.columna(datos, "sepal_length");
let sw  = Datadoz.columna(datos, "sepal_width");
let pl  = Datadoz.columna(datos, "petal_length");
let pw  = Datadoz.columna(datos, "petal_width");
let lab = Datadoz.columna(datos, "label");

let X = [];
let Y = [];
let i = 0;
while (i < n) {
    let X = append(X, [sl[i], sw[i], pl[i], pw[i]]);
    let Y = append(Y, int(lab[i]));
    let i = i + 1;
}

// Split 80/20
let split = Datadoz.train_test_split(X, Y, 0.2);
let Xtr = split[0]; let Ytr = split[1];
let Xte = split[2]; let Yte = split[3];
mostrar("Train / Test:");
mostrar(len(Xtr));
mostrar(len(Xte));

// Entrenar Naive Bayes Gaussiano
let modelo = Mldoz.nb_fit(Xtr, Ytr);
mostrar("Naive Bayes entrenado");
mostrar("Clases aprendidas:");
mostrar(modelo["classes"]);

// Predecir (batch para lista de ejemplos)
let preds = Mldoz.nb_predict_batch(modelo, Xte);
let probs = Mldoz.nb_predict_proba(modelo, Xte[0]);

let acc   = Metricsdoz.accuracy(Yte, preds);
let prec0 = Metricsdoz.precision(Yte, preds, 0);
let prec1 = Metricsdoz.precision(Yte, preds, 1);
let prec2 = Metricsdoz.precision(Yte, preds, 2);
let f1_0  = Metricsdoz.f1_score(Yte, preds, 0);
let f1_1  = Metricsdoz.f1_score(Yte, preds, 1);
let f1_2  = Metricsdoz.f1_score(Yte, preds, 2);

mostrar("Accuracy Naive Bayes:");
mostrar(acc);
mostrar("Precision [Setosa, Versicolor, Virginica]:");
mostrar([prec0, prec1, prec2]);
mostrar("F1-score [Setosa, Versicolor, Virginica]:");
mostrar([f1_0, f1_1, f1_2]);
mostrar("Probabilidades log por clase (primer ejemplo):");
mostrar(probs);

let conf = Metricsdoz.confusion_matrix(Yte, preds);
mostrar("Matriz de confusion:");
mostrar(conf["matriz"]);

// Extraer sepal_length vs sepal_width para scatter (NB usa todas las features)
let sl_test = [];
let sw_test = [];
let j = 0;
while (j < len(Xte)) {
    let sl_test = append(sl_test, Xte[j][0]);
    let sw_test = append(sw_test, Xte[j][1]);
    let j = j + 1;
}

let nombres = ["Setosa", "Versicolor", "Virginica"];

// Graficas
Plotdoz.scatter_classes(sl_test, sw_test, preds, nombres,
    "Naive Bayes — Iris (predicciones, sepal)",
    "sepal_length", "sepal_width",
    "../tests/demos/ml_sklearn/resultados/out_nb_scatter.svg");
Plotdoz.confusion_matrix(Yte, preds, nombres,
    "Naive Bayes — Matriz de confusion",
    "../tests/demos/ml_sklearn/resultados/out_nb_confmat.svg");
Plotdoz.bar_chart(nombres, [prec0, prec1, prec2],
    "Naive Bayes — Precision por clase", "Clase", "Precision",
    "../tests/demos/ml_sklearn/resultados/out_nb_precision.svg");

mostrar("=== Naive Bayes OK ===");
