// demo_knn.trez — K-Nearest Neighbors
// Dataset: iris (sklearn) — clasificacion 3 clases
// Algoritmo: Mldoz.knn_fit (distancia euclidiana, k=5)

Randomdoz.seed(42);

let datos = Datadoz.read_csv("../tests/demos/ml_sklearn/datasets/iris.csv");
let n = Datadoz.num_filas(datos);
mostrar("Filas dataset iris:");
mostrar(n);

let sl  = Datadoz.columna(datos, "sepal_length");
let sw  = Datadoz.columna(datos, "sepal_width");
let pl  = Datadoz.columna(datos, "petal_length");
let pw  = Datadoz.columna(datos, "petal_width");
let lab = Datadoz.columna(datos, "label");

// Normalizar features [0,1] manualmente
let sl_max = 7.9; let sl_min = 4.3;
let sw_max = 4.4; let sw_min = 2.0;
let pl_max = 6.9; let pl_min = 1.0;
let pw_max = 2.5; let pw_min = 0.1;

let X = [];
let Y = [];
let i = 0;
while (i < n) {
    let X = append(X, [
        (sl[i] - sl_min) / (sl_max - sl_min),
        (sw[i] - sw_min) / (sw_max - sw_min),
        (pl[i] - pl_min) / (pl_max - pl_min),
        (pw[i] - pw_min) / (pw_max - pw_min)
    ]);
    let Y = append(Y, int(lab[i]));
    let i = i + 1;
}

// Split 80/20
let split = Datadoz.train_test_split(X, Y, 0.2);
let Xtr = split[0]; let Ytr = split[1];
let Xte = split[2]; let Yte = split[3];
mostrar("Train / Test:");
mostrar(len(Xtr));
mostrar(len(Xte));

// Entrenar KNN (k=5)
let modelo = Mldoz.knn_fit(Xtr, Ytr, 5);
mostrar("KNN entrenado (k=5)");

// Predecir y convertir a int para que las metricas funcionen bien
let preds_raw = Mldoz.knn_predict(modelo, Xte);
let preds = [];
let p = 0;
while (p < len(preds_raw)) {
    let preds = append(preds, int(preds_raw[p]));
    let p = p + 1;
}

let acc   = Metricsdoz.accuracy(Yte, preds);
let prec0 = Metricsdoz.precision(Yte, preds, 0);
let prec1 = Metricsdoz.precision(Yte, preds, 1);
let prec2 = Metricsdoz.precision(Yte, preds, 2);
let f1_0  = Metricsdoz.f1_score(Yte, preds, 0);
let f1_1  = Metricsdoz.f1_score(Yte, preds, 1);
let f1_2  = Metricsdoz.f1_score(Yte, preds, 2);

mostrar("Accuracy KNN:");
mostrar(acc);
mostrar("Precision [Setosa, Versicolor, Virginica]:");
mostrar([prec0, prec1, prec2]);
mostrar("F1-score [Setosa, Versicolor, Virginica]:");
mostrar([f1_0, f1_1, f1_2]);

let conf = Metricsdoz.confusion_matrix(Yte, preds);
mostrar("Matriz de confusion:");
mostrar(conf["matriz"]);

// Extraer petal_length vs petal_width normalizados para scatter
let pl_test = [];
let pw_test = [];
let j = 0;
while (j < len(Xte)) {
    let pl_test = append(pl_test, Xte[j][2]);
    let pw_test = append(pw_test, Xte[j][3]);
    let j = j + 1;
}

let nombres = ["Setosa", "Versicolor", "Virginica"];

// Graficas
Plotdoz.scatter_classes(pl_test, pw_test, preds, nombres,
    "KNN (k=5) — Iris (predicciones)",
    "petal_length (norm)", "petal_width (norm)",
    "../tests/demos/ml_sklearn/resultados/out_knn_scatter.svg");
Plotdoz.confusion_matrix(Yte, preds, nombres,
    "KNN — Matriz de confusion",
    "../tests/demos/ml_sklearn/resultados/out_knn_confmat.svg");
Plotdoz.bar_chart(nombres, [prec0, prec1, prec2],
    "KNN — Precision por clase", "Clase", "Precision",
    "../tests/demos/ml_sklearn/resultados/out_knn_precision.svg");

mostrar("=== KNN OK ===");
