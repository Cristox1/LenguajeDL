// perceptron_and.trez — Perceptron que aprende la compuerta AND
// Entradas: todas las combinaciones de 2 bits
// Salida esperada: AND logico (1 solo cuando ambas entradas son 1)

// Tabla de verdad AND
let X = [[0, 0], [0, 1], [1, 0], [1, 1]];
let Y = [0, 0, 0, 1];

mostrar("=== Compuerta AND con Perceptron ===");
mostrar("Tabla de verdad:");
mostrar("  [0,0] -> 0");
mostrar("  [0,1] -> 0");
mostrar("  [1,0] -> 0");
mostrar("  [1,1] -> 1");

// Entrenar perceptron (lr=0.1, 100 epocas)
let modelo = NNdoz.perceptron_fit(X, Y, 0.1, 100);

mostrar("Pesos aprendidos:");
mostrar(modelo["w"]);
mostrar("Sesgo b:");
mostrar(modelo["b"]);

// Predecir las 4 combinaciones
let p00 = NNdoz.perceptron_predict(modelo, [0, 0]);
let p01 = NNdoz.perceptron_predict(modelo, [0, 1]);
let p10 = NNdoz.perceptron_predict(modelo, [1, 0]);
let p11 = NNdoz.perceptron_predict(modelo, [1, 1]);

mostrar("Predicciones:");
mostrar("  [0,0] ->");
mostrar(p00);
mostrar("  [0,1] ->");
mostrar(p01);
mostrar("  [1,0] ->");
mostrar(p10);
mostrar("  [1,1] ->");
mostrar(p11);

// Verificar que aprendio correctamente
let preds = [p00, p01, p10, p11];
let acc = Metricsdoz.accuracy(Y, preds);
mostrar("Accuracy:");
mostrar(acc);

if (acc == 1.0) {
    mostrar("Perceptron aprendio AND correctamente.");
} else {
    mostrar("No convergio — intenta mas epocas.");
}
