// demo_logreg.trez — Regresion logistica
// Dataset: breast cancer (sklearn) — clasificacion binaria maligno/benigno
// Features: 6 primeras features morfologicas del tumor
// Algoritmo: Mldoz.logreg_fit (cross-entropy + SGD)

Randomdoz.seed(7);

let datos = Datadoz.read_csv("../tests/demos/ml_sklearn/datasets/breast_cancer.csv");
let n = Datadoz.num_filas(datos);
mostrar("Filas dataset breast cancer:");
mostrar(n);

let c0 = Datadoz.columna(datos, "mean_radius");
let c1 = Datadoz.columna(datos, "mean_texture");
let c2 = Datadoz.columna(datos, "mean_perimeter");
let c3 = Datadoz.columna(datos, "mean_area");
let c4 = Datadoz.columna(datos, "mean_smoothness");
let c5 = Datadoz.columna(datos, "mean_compactness");
let lab = Datadoz.columna(datos, "label");

// Construir X (normalizado) e Y
let X = [];
let Y = [];
let i = 0;
while (i < n) {
    let X = append(X, [
        c0[i] / 30.0,
        c1[i] / 40.0,
        c2[i] / 200.0,
        c3[i] / 2500.0,
        c4[i],
        c5[i]
    ]);
    let Y = append(Y, int(lab[i]));
    let i = i + 1;
}

// Split 80/20
let split = Datadoz.train_test_split(X, Y, 0.2);
let Xtr = split[0]; let Ytr = split[1];
let Xte = split[2]; let Yte = split[3];
mostrar("Train / Test:");
mostrar(len(Xtr));
mostrar(len(Xte));

// Entrenar regresion logistica (lr=0.1, 800 epocas)
let modelo = Mldoz.logreg_fit(Xtr, Ytr, 0.1, 800);
let hist   = modelo["historia"];

mostrar("Loss inicial (cross-entropy):");
mostrar(hist[0]);
mostrar("Loss final:");
mostrar(hist[len(hist) - 1]);

// Evaluar
let preds = Mldoz.logreg_predict(modelo, Xte);
let acc   = Metricsdoz.accuracy(Yte, preds);
let prec  = Metricsdoz.precision(Yte, preds, 1);
let rec   = Metricsdoz.recall(Yte, preds, 1);
let f1    = Metricsdoz.f1_score(Yte, preds, 1);

mostrar("Accuracy:");
mostrar(acc);
mostrar("Precision (maligno=1):");
mostrar(prec);
mostrar("Recall (maligno=1):");
mostrar(rec);
mostrar("F1-score:");
mostrar(f1);

// Probabilidades primeros 5 del test
let probs = Mldoz.logreg_predict_proba(modelo, Xte.slice(0, 5));
mostrar("Probabilidades P(maligno) primeros 5:");
mostrar(probs);

// Graficas
Plotdoz.learning_curve(hist, [], "Regresion Logistica — Breast Cancer", "Epoca", "Cross-Entropy",
    "../tests/demos/ml_sklearn/resultados/out_logreg_curve.svg");
Plotdoz.confusion_matrix(Yte, preds, ["Benigno", "Maligno"],
    "Regresion Logistica — Matriz de confusion",
    "../tests/demos/ml_sklearn/resultados/out_logreg_confmat.svg");

mostrar("=== Regresion Logistica OK ===");
