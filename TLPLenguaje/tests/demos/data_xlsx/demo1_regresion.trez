// demo1_regresion.trez ──────────────────────────────────────────────────────
// Regresión lineal con datos reales.
//
// Dataset:  tests/data.xlsx (10 280 personas)
// Tarea:    predecir el ingreso mensual a partir de la edad y los años de
//           escolaridad.
//
// Pipeline:
//   1. Leer xlsx  →  lista de diccionarios
//   2. Tomar las primeras 600 filas (presentación ágil)
//   3. Construir X (edad/50, anios_esc/12)  e  Y (ingreso/10000)
//      → escalado simple: las columnas quedan en O(1) y el SGD converge rápido.
//   4. Split 80/20
//   5. Entrenar Mldoz.linreg_fit (SGD, 800 épocas, lr=0.03)
//   6. Reportar MSE en test y guardar curva de aprendizaje en SVG.
// ────────────────────────────────────────────────────────────────────────────

Randomdoz.seed(1);

let raw    = Datadoz.read_xlsx("../tests/data.xlsx");
let datos  = raw.slice(0, 600);
let n      = len(datos);
mostrar("Filas usadas:");
mostrar(n);

// Construir X (2 features) y Y (target) escalados
let X = [];
let Y = [];
let i = 0;
while (i < n) {
    let fila = Datadoz.fila(datos, i);
    let X = append(X, [fila["edad"] / 50.0, fila["anios_esc"] / 12.0]);
    let Y = append(Y, fila["ingreso_mensual"] / 10000.0);
    let i = i + 1;
}

// Split 80 / 20
let split  = Datadoz.train_test_split(X, Y, 0.2);
let Xtr = split[0]; let Ytr = split[1];
let Xte = split[2]; let Yte = split[3];

mostrar("Train / Test:");
mostrar(len(Xtr));
mostrar(len(Xte));

// Entrenar regresión lineal (SGD, 800 épocas, lr=0.03)
let modelo = Mldoz.linreg_fit(Xtr, Ytr, 0.03, 800);
let hist   = modelo["historia"];

mostrar("Pesos aprendidos [w_edad, w_anios_esc]:");
mostrar(modelo["w"]);
mostrar("Sesgo b:");
mostrar(modelo["b"]);

mostrar("Loss epoca 0 vs final:");
mostrar(hist[0]);
mostrar(hist[len(hist) - 1]);

// Evaluar MSE sobre test
let preds = Mldoz.linreg_predict(modelo, Xte);
let mse   = 0.0;
let k     = 0;
while (k < len(Yte)) {
    let err = preds[k] - Yte[k];
    let mse = mse + err * err;
    let k   = k + 1;
}
let mse = mse / len(Yte);
mostrar("MSE test:");
mostrar(mse);

// Predicción puntual: persona de 35 años, 16 años de escolaridad
let muestra   = [35.0 / 50.0, 16.0 / 12.0];
let ingreso_z = Mldoz.linreg_predict(modelo, muestra);
let ingreso_p = ingreso_z * 10000.0;
mostrar("Ingreso predicho (35 anios, 16 anios esc):");
mostrar(ingreso_p);

// Curva de aprendizaje
Plotdoz.learning_curve(hist, [], "Regresion ingreso", "Epoca", "MSE",
    "../tests/out_demo1_curve.svg");
mostrar("OK demo1");
