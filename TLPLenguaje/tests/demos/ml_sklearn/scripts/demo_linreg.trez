// demo_linreg.trez — Regresion lineal
// Dataset: diabetes (sklearn) — predecir progresion de la enfermedad
// Features: age, sex, bmi, bp, s1, s2 (6 variables clinicas)
// Algoritmo: Mldoz.linreg_fit (SGD sobre MSE)

Randomdoz.seed(1);

let datos = Datadoz.read_csv("../tests/demos/ml_sklearn/datasets/diabetes.csv");
let n = Datadoz.num_filas(datos);
mostrar("Filas dataset diabetes:");
mostrar(n);

let col_age = Datadoz.columna(datos, "age");
let col_sex = Datadoz.columna(datos, "sex");
let col_bmi = Datadoz.columna(datos, "bmi");
let col_bp  = Datadoz.columna(datos, "bp");
let col_s1  = Datadoz.columna(datos, "s1");
let col_s2  = Datadoz.columna(datos, "s2");
let col_y   = Datadoz.columna(datos, "target");

// Construir X e Y (target escalado /300 para SGD estable)
let X = [];
let Y = [];
let i = 0;
while (i < n) {
    let X = append(X, [col_age[i], col_sex[i], col_bmi[i], col_bp[i], col_s1[i], col_s2[i]]);
    let Y = append(Y, col_y[i] / 300.0);
    let i = i + 1;
}

// Split 80/20
let split = Datadoz.train_test_split(X, Y, 0.2);
let Xtr = split[0]; let Ytr = split[1];
let Xte = split[2]; let Yte = split[3];
mostrar("Train / Test:");
mostrar(len(Xtr));
mostrar(len(Xte));

// Entrenar regresion lineal (lr=0.05, 1000 epocas)
let modelo = Mldoz.linreg_fit(Xtr, Ytr, 0.05, 1000);
let hist   = modelo["historia"];

mostrar("Loss inicial:");
mostrar(hist[0]);
mostrar("Loss final:");
mostrar(hist[len(hist) - 1]);
mostrar("Pesos aprendidos:");
mostrar(modelo["w"]);

// Evaluar MSE en test (desescalado)
let preds = Mldoz.linreg_predict(modelo, Xte);
let mse = 0.0;
let k = 0;
while (k < len(Yte)) {
    let err = (preds[k] - Yte[k]) * 300.0;
    let mse = mse + err * err;
    let k = k + 1;
}
let mse = mse / len(Yte);
mostrar("MSE test (escala original):");
mostrar(mse);

// Curva de aprendizaje
Plotdoz.learning_curve(hist, [], "Regresion Lineal — Diabetes", "Epoca", "MSE",
    "../tests/demos/ml_sklearn/resultados/out_linreg_curve.svg");

mostrar("=== Regresion Lineal OK ===");
