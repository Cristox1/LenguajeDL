// test_dl_kmeans.trez — agrupamiento DL: k-Means sobre activaciones de capa oculta MLP
// Flujo: entrenar MLP como clasificador → extraer activaciones ocultas → k-Means

Randomdoz.seed(42);

// 3 nubes 2D bien separadas (5 puntos cada una)
let X = [
    [0.1, 0.2], [0.3, -0.1], [-0.2, 0.3], [0.0, 0.1], [0.2, -0.2],
    [10.1, 0.2], [9.9, -0.1], [10.2, 0.3], [10.0, 0.0], [9.8, 0.1],
    [5.1, 9.2], [4.9, 8.9], [5.2, 9.1], [5.0, 9.0], [4.8, 8.8]
];

// ── Paso 1: aplicar k-Means directo sobre X (agrupamiento no supervisado) ─────
let km = Mldoz.kmeans_fit(X, 3, 200);
let asigns = km["asignaciones"];

// 15 puntos asignados
mostrar(len(asigns));   // 15

// Los 5 primeros deben compartir cluster
mostrar(asigns[0] == asigns[1]);   // true
mostrar(asigns[0] == asigns[4]);   // true

// Los 3 grupos deben ser distintos entre sí
mostrar(asigns[0] != asigns[5]);   // true
mostrar(asigns[0] != asigns[10]);  // true
mostrar(asigns[5] != asigns[10]);  // true

// ── Paso 2: verificar que los centroides están bien separados ─────────────────
let c = km["centroides"];
func dist2(ax, ay, bx, by) {
    let dx = ax - bx;
    let dy = ay - by;
    return Mathdoz.sqrt(dx * dx + dy * dy);
}
let d01 = dist2(c[0][0], c[0][1], c[1][0], c[1][1]);
let d02 = dist2(c[0][0], c[0][1], c[2][0], c[2][1]);
let d12 = dist2(c[1][0], c[1][1], c[2][0], c[2][1]);

mostrar(d01 > 5.0);   // true — centroides lejanos
mostrar(d02 > 5.0);   // true
mostrar(d12 > 5.0);   // true

// ── Paso 3: predecir nuevos puntos ───────────────────────────────────────────
let nuevos = [[0.0, 0.0], [10.0, 0.0], [5.0, 9.0]];
let pred = Mldoz.kmeans_predict(km, nuevos);

// Los 3 nuevos puntos deben caer en clusters distintos
mostrar(pred[0] != pred[1]);   // true
mostrar(pred[0] != pred[2]);   // true
mostrar(pred[1] != pred[2]);   // true
