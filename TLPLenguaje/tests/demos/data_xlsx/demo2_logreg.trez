// demo2_logreg.trez ─────────────────────────────────────────────────────────
// Clasificación binaria: predecir el sexo de la persona a partir de edad,
// ingreso y años de escolaridad.
//
// Dataset:  tests/data.xlsx (10 280 personas)
// Etiqueta: sex ∈ {Mujer, Hombre}  →  0 / 1
//
// Pipeline:
//   1. Leer xlsx
//   2. 800 filas, codificar sex como 0/1 y escalar features
//   3. Split 80/20
//   4. Entrenar Mldoz.logreg_fit (gradiente descendente sobre cross-entropy)
//   5. Predecir y evaluar accuracy + matriz de confusión
//   6. Curva de aprendizaje + matriz de confusión en SVG
// ────────────────────────────────────────────────────────────────────────────

Randomdoz.seed(7);

let raw   = Datadoz.read_xlsx("../tests/data.xlsx");
let datos = raw.slice(0, 800);
let n     = len(datos);
mostrar("Filas usadas:");
mostrar(n);

let X = [];
let Y = [];
let i = 0;
while (i < n) {
    let fila = Datadoz.fila(datos, i);
    let X = append(X, [
        fila["edad"]            / 50.0,
        fila["ingreso_mensual"] / 10000.0,
        fila["anios_esc"]       / 12.0
    ]);
    // Codificar sex: Mujer → 0, Hombre → 1
    if (fila["sex"] == "Hombre") {
        let Y = append(Y, 1);
    } else {
        let Y = append(Y, 0);
    }
    let i = i + 1;
}

// Split 80 / 20
let split = Datadoz.train_test_split(X, Y, 0.2);
let Xtr = split[0]; let Ytr = split[1];
let Xte = split[2]; let Yte = split[3];

mostrar("Train / Test:");
mostrar(len(Xtr));
mostrar(len(Xte));

// Entrenar regresión logística (cross-entropy, 600 épocas, lr=0.1)
let modelo = Mldoz.logreg_fit(Xtr, Ytr, 0.1, 600);
let hist   = modelo["historia"];

mostrar("Pesos aprendidos:");
mostrar(modelo["w"]);
mostrar("Sesgo b:");
mostrar(modelo["b"]);
mostrar("Loss inicial / final (cross-entropy):");
mostrar(hist[0]);
mostrar(hist[len(hist) - 1]);

// Predicciones binarias y métricas
let preds = Mldoz.logreg_predict(modelo, Xte);
let acc   = Metricsdoz.accuracy(Yte, preds);
mostrar("Accuracy test:");
mostrar(acc);

let f1   = Mldoz.f1(Yte, preds);
mostrar("F1 score:");
mostrar(f1);

// Probabilidades para los 5 primeros del test
let probs = Mldoz.logreg_predict_proba(modelo, Xte.slice(0, 5));
mostrar("Probabilidades P(Hombre) primeros 5 del test:");
mostrar(probs);

// Gráficas
Plotdoz.learning_curve(hist, [], "Logreg sexo", "Epoca", "Cross-entropy",
    "../tests/out_demo2_curve.svg");
Plotdoz.confusion_matrix(Yte, preds, ["Mujer", "Hombre"],
    "Logreg — Matriz de confusion",
    "../tests/out_demo2_confmat.svg");

mostrar("OK demo2");
